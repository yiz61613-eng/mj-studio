{
  "manifest_version": 3,
  "name": "RB 画布批量导入器（漫剧直出工作台）",
  "version": "1.0.1",
  "description": "漫剧直出工作台的画布桥：在 Runroll / UpDream 画布页接收直通与链式任务；链式生成须先核验场景/角色/音频参考，并经工作台人工放行。",
  "permissions": ["tabs"],
  "host_permissions": ["http://localhost:8899/*", "http://127.0.0.1:8899/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.runroll.cn/*",
        "*://runroll.cn/*",
        "*://*.updream.cn/*",
        "*://updream.cn/*"
      ],
      "js": ["rb-core.js", "rb-adapter-runroll.js", "rb-adapter-updream.js", "rb-content-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
